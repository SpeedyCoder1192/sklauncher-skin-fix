{
	"schemaVersion": 1,
	"id": "serverskinsfirst",
	"version": "${version}",
	"name": "Server Skins First",
	"description": "Stops SKlauncher from replacing skins set by skin changing mods and plugins like FabricTailor and SkinsRestorer.",
	"authors": ["SpeedyCoder1192"],
	"license": "MIT",
	"icon": "assets/serverskinsfirst/icon.png",
	"contact": {
		"sources": "https://github.com/SpeedyCoder1192/server-skins-first",
		"issues": "https://github.com/SpeedyCoder1192/server-skins-first/issues"
	},
	"environment": "client",
	"mixins": [
		"serverskinsfirst.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=${java}"
	}
}
