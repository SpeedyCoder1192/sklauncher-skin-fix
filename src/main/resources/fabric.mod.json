{
	"schemaVersion": 1,
	"id": "sklauncherskinfix",
	"version": "${version}",
	"name": "SKlauncher Skin Fix",
	"description": "Stops SKlauncher from replacing skins set by skin changing mods and plugins like FabricTailor and SkinsRestorer.",
	"authors": ["SpeedyCoder1192"],
	"license": "MIT",
	"icon": "assets/sklauncherskinfix/icon.png",
	"contact": {
		"sources": "https://github.com/SpeedyCoder1192/sklauncher-skin-fix",
		"issues": "https://github.com/SpeedyCoder1192/sklauncher-skin-fix/issues"
	},
	"environment": "client",
	"mixins": [
		"sklauncherskinfix.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=${java}"
	}
}
